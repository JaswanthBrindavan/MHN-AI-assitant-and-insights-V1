# ---- Davi Health AI — example config (never commit real secrets) ----

# Postgres (async app engine uses asyncpg; Alembic uses a sync driver).
# On Railway/production this is the SHARED database mhn-spring migrates.
DATABASE_URL=postgresql+asyncpg://davi:davi@db:5432/davi
ALEMBIC_DATABASE_URL=postgresql+psycopg2://davi:davi@db:5432/davi

# Auth — aligned with the mhn-spring production backend:
# session JWTs are HS512 and Spring Base64-DECODES JWT_SECRET before HMAC.
# Use the SAME JWT_SECRET value as mhn-spring.
AUTH_ENABLED=false
JWT_SECRET=change-me-in-prod
JWT_ALGORITHM=HS512
JWT_SECRET_BASE64=true
# Optional server-to-server path (Spring/BFF → Davi): static bearer ≥32 chars,
# caller supplies X-User-Id. Empty disables it.
SERVICE_TOKEN=

# LLM — model/cloud agnostic:
# "fake" (tests/dev) | "anthropic" | "openai_compatible" | "ollama"
LLM_PROVIDER=fake
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1
LLM_PROMPT_VERSION=v1

# Reply language: "auto" mirrors the user's detected language
REPLY_LANGUAGE=auto

# Embedding service (optional, OpenAI-compatible /v1/embeddings). If unset,
# knowledge ingests with NULL embeddings and retrieval falls back to keyword
# search (fail-open). Leave empty on Railway unless a hosted endpoint exists.
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_DIM=1024

# Grounding verifier: off | log | enforce
GROUNDING_MODE=enforce

# Deploy/testing: "true" runs `alembic upgrade head` at container start —
# ONLY for a standalone/test database. Never against the shared production DB
# (schema there is owned by mhn-spring's Flyway; see db/flyway/).
RUN_MIGRATIONS_ON_START=false

# Pipeline / app
PIPELINE_VERSION=1
APP_ENV=dev

# Translation sidecar (translator/ — self-hosted IndicTrans2 stack). Empty =
# feature off; non-English users then get English + the LLM language
# directive. Railway private networking is http:// and needs the scheme.
TRANSLATE_BASE_URL=
TRANSLATE_TOKEN=
TRANSLATE_TIMEOUT_SECONDS=8.0

# ---- Vision (Tasks 17-18). OFF unless MHN_SPRING_BASE_URL is set. ----
# Davi holds NO AWS credentials. To read document bytes it asks Spring — which
# owns the bucket and already authorizes file reads — to mint a short-lived
# presigned GET. Davi checks the family-consent gate itself first, so a bug in
# either service alone cannot widen access.
# MHN_SPRING_TOKEN must be a value Spring accepts for service-to-service calls
# (same pattern as MHN_AI_TOKEN).
MHN_SPRING_BASE_URL=
MHN_SPRING_TOKEN=
MHN_SPRING_TIMEOUT_SECONDS=15.0

# Vision is additionally gated by its own flag: reading bytes and sending them
# to a model are separate decisions.
VISION_ENABLED=false
VISION_MODEL=

# ---- Voice (Task 19). OFF unless VOICE_BASE_URL is set. ----
# Self-hosted sidecar, same pattern as TRANSLATE_BASE_URL — PHI never leaves
# the deployment. Transcription runs BEFORE the triage floor, so a spoken red
# flag reaches it exactly as a typed one does.
VOICE_BASE_URL=
VOICE_TOKEN=
VOICE_TIMEOUT_SECONDS=30.0
