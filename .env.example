# ---- Davi Health AI — example config (never commit real secrets) ----

# Postgres (async app engine uses asyncpg; Alembic uses a sync driver)
DATABASE_URL=postgresql+asyncpg://davi:davi@db:5432/davi
ALEMBIC_DATABASE_URL=postgresql+psycopg2://davi:davi@db:5432/davi

# Auth
AUTH_ENABLED=false
JWT_SECRET=change-me-in-prod
JWT_ALGORITHM=HS256

# LLM provider selection: "fake" (tests/dev) | "ollama"
LLM_PROVIDER=fake
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1
LLM_PROMPT_VERSION=v1

# Embedding service (optional). If unset, knowledge ingests with NULL embeddings
# and RAG retrieval falls back to keyword search.
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_DIM=1024

# Grounding verifier: off | log | enforce
GROUNDING_MODE=log

# Pipeline / app
PIPELINE_VERSION=1
APP_ENV=dev
