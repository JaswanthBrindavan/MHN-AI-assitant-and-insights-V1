# Embedding service for Davi — Ollama with qwen3-embedding:0.6b BAKED IN.
#
# Deployed as its own Railway service (Settings → Build → Dockerfile Path =
# Dockerfile.ollama). Baking the model into the image means cold starts serve
# immediately — no volume, no startup download. Image ≈ 1.3 GB.
#
# PRIVATE-ONLY service: give it NO public domain. Davi reaches it over
# Railway's private network at  http://<service-name>.railway.internal:11434/v1
#
# Query-time embedding of a short chat message is fast on CPU (~100–500 ms);
# the heavy work (embedding all 16,637 corpus chunks) is done ONCE at ingest
# time from a dev machine and stored in pgvector — this service never does it.

FROM ollama/ollama:latest

# Pull the model at BUILD time (serve briefly, pull, stop).
RUN ollama serve & \
    sleep 5 && \
    ollama pull qwen3-embedding:0.6b && \
    sleep 2

# Listen on all interfaces for Railway's private network.
ENV OLLAMA_HOST=0.0.0.0:11434
# Keep the model resident between requests (no per-request load latency).
ENV OLLAMA_KEEP_ALIVE=24h

EXPOSE 11434
